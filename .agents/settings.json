{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{"type": "command", "command": "python3 .agents/hooks/pre_tool_use.py"}]
      },
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [{"type": "command", "command": "python3 .agents/hooks/time_reminder.py"}]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Edit|Write",
        "hooks": [{"type": "command", "command": "python3 .agents/hooks/post_tool_use.py"}]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "model-infer-implementer",
        "hooks": [{"type": "command", "command": "python3 .agents/hooks/subagent_stop.py"}]
      }
    ]
  }
}
