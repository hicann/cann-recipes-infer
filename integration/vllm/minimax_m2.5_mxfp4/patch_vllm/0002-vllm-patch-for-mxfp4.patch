+import os
 from collections.abc import Callable
 from typing import Any

@@ -127,13 +128,38 @@ def get_padding_alignment():
 def _dequant_mxfp4(
     x: torch.Tensor, scale: torch.Tensor, float_dtype: torch.dtype
 ) -> torch.Tensor:
+    if not (current_platform.is_cuda() or current_platform.is_rocm()):
+        if x.numel() == 0:
+            return torch.empty(
+                (*x.shape[:-1], x.shape[-1] * 2),
+                dtype=float_dtype,
+                device=x.device,
+            )
+        fp4_e2m1_table = torch.tensor(
+            [
+                0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0,
+                0.0, -0.5, -1.0, -1.5, -2.0, -3.0, -4.0, -6.0,
+            ],
+            dtype=torch.float32,
+            device=x.device,
+        )
+        x_i32 = x.to(torch.int32)
+        lo = torch.remainder(x_i32, 16).to(torch.long)
+        hi = torch.div(x_i32, 16, rounding_mode="floor").to(torch.long)
+        unpacked = torch.stack((lo, hi), dim=-1).reshape(*x.shape[:-1], -1)
+        group_scale = torch.pow(
+            2.0, (scale.to(torch.int16) - 127).to(torch.float32)
+        )
+        expanded_scale = group_scale.repeat_interleave(32, dim=-1)
+        expanded_scale = expanded_scale[..., : unpacked.shape[-1]]
+        return (fp4_e2m1_table[unpacked] * expanded_scale).to(float_dtype)
+
     try:
         from quark.torch.kernel import mx
     except ImportError as err:
         raise ImportError(
-            "The package `amd-quark` is required to use "
-            "MX-FP4 models. Please install it with `pip install "
-            "amd-quark`."
+            "The package amd-quark is required to use "
+            "MX-FP4 models. Please install it with pip install amd-quark."
         ) from err

     return mx.dq_mxfp4(x, scale, float_dtype)
@@ -150,13 +176,55 @@ def _dequant_mxfp4_fake(
 def _quant_dequant_mxfp4(
     x: torch.Tensor, scale_calculation_mode: str = "even"
 ) -> torch.Tensor:
+    if x.numel() == 0:
+        return x
+
+    if os.getenv("VLLM_MXFP4_SKIP_ACT_QDQ", "0") == "1":
+        return x
+
+    # amd-quark qdq_mxfp4 is CUDA/ROCm-only. On NPU (and other backends),
+    # use a pure-PyTorch MXFP4 E2M1 codebook + power-of-two block scale QDQ.
+    if not (current_platform.is_cuda() or current_platform.is_rocm()):
+        x_fp = x.to(torch.float32)
+        block = 32
+        last = x_fp.shape[-1]
+        pad = (block - (last % block)) % block
+        if pad:
+            x_fp = torch.nn.functional.pad(x_fp, (0, pad))
+
+        x_view = x_fp.view(*x_fp.shape[:-1], -1, block)
+
+        max_abs = x_view.abs().amax(dim=-1, keepdim=True)
+        scale_factor = float(os.getenv("VLLM_MXFP4_ACT_QDQ_SCALE_FACTOR", "6.0"))
+        raw_scale = torch.clamp(max_abs / scale_factor, min=2.0**-30)
+        log2_scale = torch.round(torch.log2(raw_scale))
+        scale = torch.exp2(log2_scale)
+
+        y = x_view / scale
+        y_abs = y.abs()
+
+        q_abs = torch.zeros_like(y_abs)
+        q_abs = torch.where(y_abs >= 0.25, 0.5, q_abs)
+        q_abs = torch.where(y_abs >= 0.75, 1.0, q_abs)
+        q_abs = torch.where(y_abs >= 1.25, 1.5, q_abs)
+        q_abs = torch.where(y_abs >= 1.75, 2.0, q_abs)
+        q_abs = torch.where(y_abs >= 2.50, 3.0, q_abs)
+        q_abs = torch.where(y_abs >= 3.50, 4.0, q_abs)
+        q_abs = torch.where(y_abs >= 5.00, 6.0, q_abs)
+
+        q = torch.sign(y) * q_abs
+        dq = (q * scale).reshape(*x_fp.shape[:-1], -1)
+
+        if pad:
+            dq = dq[..., :last]
+        return dq.to(x.dtype)
+
     try:
         from quark.torch.kernel import mx
     except ImportError as err:
         raise ImportError(
-            "The package `amd-quark` is required to use "
-            "MX-FP4 models. Please install it with `pip install "
-            "amd-quark`."
+            "The package amd-quark is required to use "
+            "MX-FP4 models. Please install it with pip install amd-quark."
         ) from err

     return mx.qdq_mxfp4(x, scale_calculation_mode)
