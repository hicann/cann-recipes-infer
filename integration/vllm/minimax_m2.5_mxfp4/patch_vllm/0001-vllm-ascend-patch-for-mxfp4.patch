diff --git a/vllm_ascend/patch/worker/patch_minimax_m2_kvcache_mxfp4.py b/vllm_ascend/patch/worker/patch_minimax_m2_kvcache_mxfp4.py
new file mode 100644
new file mode 100644
index 00000000..a2702452
--- /dev/null
+++ b/vllm_ascend/patch/worker/patch_minimax_m2_kvcache_mxfp4.py
@@ -0,0 +1,172 @@
+#
+# Copyright (c) 2026 Huawei Technologies Co., Ltd. All Rights Reserved.
+# This file is a part of the vllm-ascend project.
+#
+# Licensed under the Apache License, Version 2.0 (the "License");
+# you may not use this file except in compliance with the License.
+# You may obtain a copy of the License at
+#
+#     http://www.apache.org/licenses/LICENSE-2.0
+#
+# Unless required by applicable law or agreed to in writing, software
+# distributed under the License is distributed on an "AS IS" BASIS,
+# WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+# See the License for the specific language governing permissions and
+# limitations under the License.
+#
+# MiniMax-M2 KV-cache MXFP4 QDQ + block-32 Hadamard rotation on (Q, K).
+#
+# Hook MiniMaxM2Attention.{__init__,forward} (after patch_minimax_m2.py
+# has already replaced them) to:
+#   1. attach a per-layer Hadamard buffer at __init__ time (outside any
+#      compile context, so no dict mutation happens during forward), and
+#   2. rotate Q and K by a block-diagonal Hadamard inside each 32-dim
+#      MXFP4 group (preserves Q@K because H is orthogonal), then QDQ K
+#      and V via per-token MXFP4 (group_size=32 along head_dim) BEFORE
+#      the kv-cache write inside self.attn.
+#
+# The first VLLM_KV_MXFP4_ANCHOR tokens of each sequence are kept at BF16
+# (no QDQ) -- implemented as a static torch.where, so torch.compile can
+# trace through the forward graph.
+#
+# Environment knobs (read once at import; restart the server to change):
+#   VLLM_KV_MXFP4_SKIP        = "1"  -> disable everything (debug)
+#   VLLM_KV_MXFP4_SKIP_QDQ    = "1"  -> only rotate, skip K/V QDQ
+#   VLLM_KV_MXFP4_SKIP_ROTATE = "1"  -> only QDQ, skip rotation
+#   VLLM_KV_MXFP4_ANCHOR      = "32" -> # of leading tokens kept BF16
+#   VLLM_KV_MXFP4_GROUP_SIZE  = "32" -> MXFP4 group size along head_dim
+
+import os
+
+import torch
+
+from vllm.model_executor.models.minimax_m2 import MiniMaxM2Attention
+from vllm.model_executor.layers.quantization.utils.mxfp4_utils import (
+    quant_dequant_mxfp4,
+)
+from vllm_ascend.ops.rotary_embedding import get_cos_and_sin_slice
+
+
+_KV_MXFP4_SKIP = os.getenv("VLLM_KV_MXFP4_SKIP", "0") == "1"
+_KV_MXFP4_SKIP_QDQ = os.getenv("VLLM_KV_MXFP4_SKIP_QDQ", "0") == "1"
+_KV_MXFP4_SKIP_ROTATE = os.getenv("VLLM_KV_MXFP4_SKIP_ROTATE", "0") == "1"
+_KV_MXFP4_ANCHOR = int(os.getenv("VLLM_KV_MXFP4_ANCHOR", "32"))
+_KV_MXFP4_GROUP = int(os.getenv("VLLM_KV_MXFP4_GROUP_SIZE", "32"))
+
+
+def _build_hadamard(n: int) -> torch.Tensor:
+    """Sylvester construction of an n x n normalized Hadamard matrix.
+
+    n must be a power of two. H @ H.T = I, so (Hq) . (Hk) = q . k.
+    """
+    assert n > 0 and (n & (n - 1)) == 0, f"Hadamard size must be 2^k, got {n}"
+    h = torch.ones((1, 1), dtype=torch.float32)
+    while h.shape[0] < n:
+        h = torch.cat(
+            (
+                torch.cat((h, h), dim=1),
+                torch.cat((h, -h), dim=1),
+            ),
+            dim=0,
+        )
+    return h / (n ** 0.5)
+
+
+# Module-level constant CPU Hadamard (FP32). Moved to NPU once per layer
+# at __init__ time below.  Kept in FP32 so the rotation matmul runs at
+# full precision; the result is cast back to the activation dtype (BF16).
+_H_CPU_FP32 = _build_hadamard(_KV_MXFP4_GROUP)
+
+
+def _block_hadamard(x: torch.Tensor, h: torch.Tensor, group: int) -> torch.Tensor:
+    """Apply block-diagonal Hadamard rotation along the last dim in FP32.
+
+    `x` shape: (..., last) with last % group == 0.
+    `h`: FP32 Hadamard buffer on the same device as x, shape (group, group).
+    """
+    orig_dtype = x.dtype
+    last = x.shape[-1]
+    x_view = x.float().view(*x.shape[:-1], last // group, group)
+    return torch.matmul(x_view, h).reshape(*x.shape[:-1], last).to(orig_dtype)
+
+
+def _mxfp4_qdq_with_anchor(
+    x: torch.Tensor, positions: torch.Tensor, anchor: int
+) -> torch.Tensor:
+    """QDQ all tokens via MXFP4, then select between original and QDQ
+    output per-token. Static graph: mask is a tensor compare, no Python
+    branch on tensor values.
+
+    `x` is (T, F); `positions` is (T,).
+    """
+    x_qdq = quant_dequant_mxfp4(x)
+    if anchor <= 0:
+        return x_qdq
+    mask = (positions >= anchor).unsqueeze(-1)
+    return torch.where(mask, x_qdq, x)
+
+
+# --- Patch __init__: attach the Hadamard buffer once per layer ----------
+
+_original_attention_init = MiniMaxM2Attention.__init__
+
+
+def _patched_init(self, *args, **kwargs) -> None:
+    _original_attention_init(self, *args, **kwargs)
+    # Register the Hadamard buffer on the current NPU device so it's
+    # available for matmul during forward (the model is created per-worker
+    # on its target NPU; CPU buffer would mismatch the activation device).
+    # Non-persistent => excluded from state_dict.
+    device = torch.device(f"npu:{torch.npu.current_device()}")
+    self.register_buffer(
+        "_kv_mxfp4_hadamard",
+        _H_CPU_FP32.to(device=device),
+        persistent=False,
+    )
+
+
+MiniMaxM2Attention.__init__ = _patched_init
+
+
+# --- Patch forward: rotation + KV MXFP4 QDQ -----------------------------
+
+_original_attention_forward = MiniMaxM2Attention.forward
+
+
+def _patched_forward(
+    self,
+    positions: torch.Tensor,
+    hidden_states: torch.Tensor,
+) -> torch.Tensor:
+    if _KV_MXFP4_SKIP:
+        return _original_attention_forward(self, positions, hidden_states)
+
+    qkv, _ = self.qkv_proj(hidden_states)
+    cos, sin = get_cos_and_sin_slice()
+    q, k, v = torch.ops.vllm.split_qkv_tp_rmsnorm_rope(
+        input=qkv,
+        q_weight=self.q_norm.weight,
+        k_weight=self.k_norm.weight,
+        q_hidden_size=self.q_size,
+        kv_hidden_size=self.kv_size,
+        head_dim=self.head_dim,
+        rotary_dim=getattr(self.rotary_emb, "rotary_dim", self.head_dim),
+        eps=self.q_norm.variance_epsilon,
+        tp_world=self.q_norm.tp_world,
+        cos=cos,
+        sin=sin,
+    )
+
+    if not _KV_MXFP4_SKIP_ROTATE:
+        # Per-layer pre-allocated Hadamard buffer (registered in __init__).
+        h = self._kv_mxfp4_hadamard
+        q = _block_hadamard(q, h, _KV_MXFP4_GROUP)
+        k = _block_hadamard(k, h, _KV_MXFP4_GROUP)
+
+    if not _KV_MXFP4_SKIP_QDQ:
+        k = _mxfp4_qdq_with_anchor(k, positions, _KV_MXFP4_ANCHOR)
+        v = _mxfp4_qdq_with_anchor(v, positions, _KV_MXFP4_ANCHOR)
+
+    attn_output = self.attn(q, k, v)
+    output, _ = self.o_proj(attn_output)
+    return output
--
