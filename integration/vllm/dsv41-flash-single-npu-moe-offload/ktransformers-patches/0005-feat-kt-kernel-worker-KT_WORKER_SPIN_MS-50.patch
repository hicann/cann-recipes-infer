         thread_state_[thread_id].cv.wait(lock, [&] {
           return thread_state_[thread_id].status.load(std::memory_order_acquire) != ThreadStatus::WAITING;
@@ -492,7 +524,7 @@ void NumaJobDistributor::worker_thread(int numa_id) {
