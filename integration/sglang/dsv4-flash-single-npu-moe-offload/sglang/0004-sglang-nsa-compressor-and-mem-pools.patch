--- /dev/null
+++ b/python/sglang/srt/hardware_backend/npu/nsa_compressor_mode.py
@@ -0,0 +1,42 @@
+"""Select the NSA compressor calling convention (single-state vs split-state).
+
+Two mutually-exclusive ``torch.ops.custom.compressor`` ABIs exist across CANN
+versions, and this branch (dsv4_one_card_dev) must run on both images. The
+convention is chosen **purely by an environment variable** (no autodetection):
+
+  ``KT_NSA_COMPRESSOR_MODE`` = ``split`` (default) | ``single``
+
+  * ``split``  — CANN 8.5.0 **private** 19-arg ``compressor(kv_state,
+                 score_state, kv_block_table, score_block_table, ...)`` over TWO
+                 separate paged buffers. This is the ORIGINAL fork behavior and
+                 the **default**, so the legacy 8.5.0 repro image is never
+                 broken by pulling this branch.
+  * ``single`` — CANN 9.0.0+ **public** 18-arg ``compressor(state_cache,
+                 state_block_table, ...)`` over ONE interleaved ``[kv | score]``
+                 paged buffer. Set this explicitly on 9.0.0 boxes.
+
+The two are incompatible (buffer layout + kwarg names differ), hence the hard
+switch instead of a runtime fallback.
+"""
+
+import functools
+import os
+
+_SINGLE = {"single", "1", "true", "public", "9", "9.0.0"}
+_SPLIT = {"split", "0", "false", "private", "8", "8.5.0", ""}
+
+
+@functools.lru_cache(maxsize=1)
+def use_single_state_compressor() -> bool:
+    """True → public 18-arg single-state op; False → private 19-arg split-state.
+
+    Controlled only by ``KT_NSA_COMPRESSOR_MODE`` (default ``split``).
+    """
+    mode = os.environ.get("KT_NSA_COMPRESSOR_MODE", "split").strip().lower()
+    if mode in _SINGLE:
+        return True
+    if mode in _SPLIT:
+        return False
+    raise ValueError(
+        f"KT_NSA_COMPRESSOR_MODE must be one of single|split, got {mode!r}"
+    )
