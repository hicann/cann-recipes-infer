+def _flat_kda_gate(
+    gate: torch.Tensor, layer, *, gate_is_flat: bool
+) -> torch.Tensor:
+    """Hand fused_kda_gate_npu a tensor whose last dim is heads*head_dim.
+
+    Kimi hands the gate over head-split as ``[..., heads, head_dim]``; GLM-5.3
+    hands it over already flat, straight off f_b_proj. Flattening the last two
+    dims unconditionally would fold the token axis into the feature axis for
+    GLM. The layouts are indistinguishable by shape when there is one head per
+    rank, so the caller supplies the layout explicitly. Both branches are views,
+    not copies.
+    """
+    flat_width = layer.A_log.numel() * layer.head_k_dim
+    if gate_is_flat:
+        if gate.shape[-1] != flat_width:
+            raise ValueError(
+                f"flat KDA gate width {gate.shape[-1]} != expected {flat_width}"
+            )
+        return gate
+
+    expected_tail = (layer.A_log.numel(), layer.head_k_dim)
+    if tuple(gate.shape[-2:]) != expected_tail:
+        raise ValueError(
+            f"head-split KDA gate tail {tuple(gate.shape[-2:])} "
+            f"!= expected {expected_tail}"
+        )
+    return gate.flatten(-2)
+
